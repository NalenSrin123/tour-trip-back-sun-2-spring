{
  "info": {
    "name": "Tour Trip API — Payment Module",
    "description": "Booking, Participant, Invoice, Payment and Receipt endpoints. Pair with the TourTripAPI Local environment (sets {{baseUrl}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081/api/v1" },
    { "key": "bookingId", "value": "1" },
    { "key": "participantId", "value": "1" },
    { "key": "invoiceId", "value": "1" },
    { "key": "paymentId", "value": "1" },
    { "key": "receiptId", "value": "1" }
  ],
  "item": [
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"tourScheduleId\": 101,\n  \"specialRequests\": \"Vegetarian meals\",\n  \"bookingType\": \"Family\",\n  \"participantRequests\": [\n    { \"name\": \"Sok Dara\", \"ageGroup\": \"Adult\", \"sex\": \"Male\" },\n    { \"name\": \"Chan Thida\", \"ageGroup\": \"Adult\", \"sex\": \"Female\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get All Bookings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Get Booking By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Update Booking",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"tourScheduleId\": 101,\n  \"specialRequests\": \"Vegetarian meals, window seat\",\n  \"bookingType\": \"Family\"\n}"
            }
          }
        },
        {
          "name": "Delete Booking",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}"] }
          }
        }
      ]
    },
    {
      "name": "Participants",
      "item": [
        {
          "name": "Create Participant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/participants?bookingId={{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["participants"],
              "query": [{ "key": "bookingId", "value": "{{bookingId}}" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sok Visal\",\n  \"ageGroup\": \"Child\",\n  \"sex\": \"Male\"\n}"
            }
          }
        },
        {
          "name": "Get All Participants",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/participants", "host": ["{{baseUrl}}"], "path": ["participants"] }
          }
        },
        {
          "name": "Get Participant By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/participants/{{participantId}}", "host": ["{{baseUrl}}"], "path": ["participants", "{{participantId}}"] }
          }
        },
        {
          "name": "Update Participant",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/participants/{{participantId}}", "host": ["{{baseUrl}}"], "path": ["participants", "{{participantId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sok Visal\",\n  \"ageGroup\": \"Adult\",\n  \"sex\": \"Male\"\n}"
            }
          }
        },
        {
          "name": "Delete Participant",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/participants/{{participantId}}", "host": ["{{baseUrl}}"], "path": ["participants", "{{participantId}}"] }
          }
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "Create Invoice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/invoices", "host": ["{{baseUrl}}"], "path": ["invoices"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": {{bookingId}},\n  \"subTotal\": 400.00,\n  \"taxAmount\": 50.00,\n  \"totalAmount\": 450.00\n}"
            }
          }
        },
        {
          "name": "Get All Invoices",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/invoices", "host": ["{{baseUrl}}"], "path": ["invoices"] }
          }
        },
        {
          "name": "Get Invoice By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["invoices", "{{invoiceId}}"] }
          }
        },
        {
          "name": "Update Invoice",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["invoices", "{{invoiceId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subTotal\": 420.00,\n  \"taxAmount\": 50.00,\n  \"totalAmount\": 470.00\n}"
            }
          }
        },
        {
          "name": "Delete Invoice",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["invoices", "{{invoiceId}}"] }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment (ABA Pay)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": {{invoiceId}},\n  \"amount\": 450.00,\n  \"paymentMethod\": \"aba_pay\"\n}"
            }
          }
        },
        {
          "name": "Create Payment (Card)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": {{invoiceId}},\n  \"amount\": 450.00,\n  \"paymentMethod\": \"card\"\n}"
            }
          }
        },
        {
          "name": "Create Payment (Bank Transfer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": {{invoiceId}},\n  \"amount\": 450.00,\n  \"paymentMethod\": \"bank_transfer\"\n}"
            }
          }
        },
        {
          "name": "Get All Payments",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "Get Payment By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["payments", "{{paymentId}}"] }
          }
        },
        {
          "name": "Update Payment",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["payments", "{{paymentId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": {{invoiceId}},\n  \"amount\": 460.00,\n  \"paymentMethod\": \"card\"\n}"
            }
          }
        },
        {
          "name": "Delete Payment",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["payments", "{{paymentId}}"] }
          }
        }
      ]
    },
    {
      "name": "Receipts",
      "item": [
        {
          "name": "Create Receipt",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/receipts", "host": ["{{baseUrl}}"], "path": ["receipts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiptNo\": \"REC-2026-0010\",\n  \"tourTittle\": \"Angkor Wat Tour\"\n}"
            }
          }
        },
        {
          "name": "Get All Receipts",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/receipts", "host": ["{{baseUrl}}"], "path": ["receipts"] }
          }
        },
        {
          "name": "Get Receipt By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/receipts/{{receiptId}}", "host": ["{{baseUrl}}"], "path": ["receipts", "{{receiptId}}"] }
          }
        },
        {
          "name": "Update Receipt",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/receipts/{{receiptId}}", "host": ["{{baseUrl}}"], "path": ["receipts", "{{receiptId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tourTittle\": \"Angkor Wat Sunrise Tour\"\n}"
            }
          }
        },
        {
          "name": "Delete Receipt",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/receipts/{{receiptId}}", "host": ["{{baseUrl}}"], "path": ["receipts", "{{receiptId}}"] }
          }
        }
      ]
    }
  ]
}
